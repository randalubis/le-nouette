# LOCAL DEVELOPMENT: do not put real values here or in .env.local. `next dev` loads .env.development.local
# BEFORE .env.local (Next load order: process.env, .env.development.local, .env.local, .env.development, .env).
# Create app/.env.development.local (gitignored) with:
#   DATABASE_URL=postgres://localhost:5432/le_nouette_dev   (local Postgres; create + seed it with `npm run dev:db`)
#   ADMIN_EMAIL=dev@lenouette.local, ADMIN_PASSWORD=<throwaway>, ADMIN_SESSION_SECRET=<random 40+ chars>
#   NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
# .env.local is for production-connected values only; dev scripts (db:seed, test:integration, dev-seed) refuse non-local DATABASE_URL.

DATABASE_URL=

# Founder OS login gate (app/src/proxy.ts, app/src/lib/founder-auth.ts).
# Single hardcoded operator account, constant-time compare, no user table.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Secret used to HMAC-sign the founder session cookie. Any long random string.
ADMIN_SESSION_SECRET=
# Optional. Lets /founder/dev-tools?key=<value> reach Reset data in production
# (normally dev-only). Leave unset to keep the deployed site fully local-dev-only.
RESET_TOOL_SECRET=

# Storefront WhatsApp button (digits only, country code first, e.g. 628123456789). Button is hidden when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=62812xxxxxxxx
