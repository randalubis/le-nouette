{
  "name": "le-nouette-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test src/lib/domain/*.test.ts src/lib/export.test.ts src/lib/founder-auth.test.ts src/lib/export-guard.test.ts src/proxy.test.ts",
    "test:integration": "DATABASE_URL=postgres://localhost:5432/le_nouette_dev tsx --conditions=react-server --require ./scripts/stub-next-cache.cjs --test --test-force-exit src/lib/db/actions.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "DATABASE_URL=postgres://localhost:5432/le_nouette_dev tsx drizzle/seed.ts",
    "dev:db": "sh scripts/dev-db.sh",
    "dev:db:reset": "sh scripts/dev-db.sh --reset",
    "e2e:setup": "sh e2e/setup.sh",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/pdfkit": "^0.17.6",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "next": "16.3.5",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "typescript": "^5"
  }
}
