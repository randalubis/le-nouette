generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String         @id @default(cuid())
  name        String
  description String?
  imageUrl    String
  basePrice   Int
  isActive    Boolean        @default(true)
  // L-04: 'square' (1:1) or 'portrait' (4:5). Renderable by reading
  // straight into a CSS aspect-ratio var on the card.
  aspectRatio String         @default("square")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  roundItems  RoundProduct[]
}

model PreorderRound {
  id                String         @id @default(cuid())
  title             String
  opensAt           DateTime
  closesAt          DateTime
  deliveryDate      DateTime
  status            RoundStatus    @default(DRAFT)
  qrisImageUrl      String?
  bankName          String?
  bankAccountNumber String?
  bankAccountHolder String?
  // L-10: optional one-paragraph "from the kitchen" note rendered between
  // the round banner and the product grid on the storefront. Hidden when
  // empty.
  story             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  items             RoundProduct[]
  orders            Order[]
}

model RoundProduct {
  id         String        @id @default(cuid())
  roundId    String
  productId  String
  price      Int
  stockLimit Int
  stockSold  Int           @default(0)
  round      PreorderRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@unique([roundId, productId])
  @@index([roundId])
}

model Order {
  id                   String        @id @default(cuid())
  shortCode            String        @unique
  roundId              String
  review               Review?
  customerName         String
  customerWhatsApp     String
  // Canonical E.164-style form (digits only, leading 62) of customerWhatsApp.
  // Always written through normalizeWhatsApp so the customers page and admin
  // search can dedupe across "0812…" / "+62812…" / "62812…" variants. (X-05.)
  normalizedWhatsApp   String?
  paymentMethod        PaymentMethod
  status               OrderStatus   @default(PENDING_PAYMENT)
  totalAmount          Int
  notes                String?
  adminNotes           String?
  // Soft-hold cutoff for QRIS / Bank Transfer orders. If proof isn't
  // uploaded by this time the lazy reconciler in /api/orders cancels the
  // order and restores stock. NULL means no hold (COD or already paid). (X-04.)
  stockHoldExpiresAt   DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  round                PreorderRound @relation(fields: [roundId], references: [id])
  items                OrderItem[]
  payment              Payment?
  statusEvents         OrderStatusEvent[]

  @@index([roundId])
  @@index([status])
  @@index([createdAt])
  @@index([normalizedWhatsApp])
  @@index([stockHoldExpiresAt])
}

model OrderStatusEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actor      String
  note       String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id             String       @id @default(cuid())
  orderId        String
  roundProductId String
  quantity       Int
  unitPrice      Int
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  roundProduct   RoundProduct @relation(fields: [roundProductId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model Payment {
  id            String    @id @default(cuid())
  orderId       String    @unique
  proofImageUrl String?
  paidAt        DateTime?
  verifiedAt    DateTime?
  verifiedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// L-06: post-delivery 1-emoji reviews. One per order. Surfaced as social
// proof on the closed-round teaser (most recent positives only).
model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  rating    Int      // 1 = bad, 2 = ok, 3 = excellent
  comment   String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([rating])
  @@index([createdAt])
}

// Audit log for admin-driven stock changes outside the order flow (e.g.
// the dashboard's "+5 stok" button). Order-driven changes already write
// OrderStatusEvent. (Plan ticket N-06.)
model StockAdjustment {
  id        String   @id @default(cuid())
  productId String
  roundId   String
  delta     Int
  actor     String
  createdAt DateTime @default(now())

  @@index([roundId])
  @@index([productId])
}

model OrderCounter {
  id    Int @id @default(1)
  value Int @default(0)
}

model BusinessSettings {
  id               Int      @id @default(1)
  businessName     String   @default("Le Nouette")
  whatsappNumber   String?
  deliveryLocation String?
  aboutBlurb       String?
  // Free-text cadence shown on the closed-round teaser, e.g.
  // "Senin pagi, antar Jumat". Sets expectation without committing to
  // exact dates. (Plan ticket N-01.)
  typicalCadence   String?
  // L-11: per-method FAQ answers shown on the order confirmation page.
  // Shape: { qris?: { check?, rejected?, wrongAmount?, online? },
  //          cod?:  { method?, fee?, absent? } }
  // Falls back to hardcoded defaults when null or partial.
  faqAnswers       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Captured on the closed-round teaser. Activated by L-01 (Phase 3) which
// will fan out a WhatsApp message to every row where optedOutAt is null
// when a round transitions to OPEN. (Plan ticket N-01.)
model NotifySubscriber {
  id         String    @id @default(cuid())
  whatsapp   String    @unique
  createdAt  DateTime  @default(now())
  optedOutAt DateTime?

  @@index([optedOutAt])
}

enum RoundStatus {
  DRAFT
  OPEN
  CLOSED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  QRIS
  BANK_TRANSFER
  COD
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_CONFIRMATION  // X-06: COD orders land here until admin confirms
  PAID
  CONFIRMED
  DELIVERED
  CANCELLED
  HOLD_EXPIRED          // X-04: soft-hold reconciler set this after timeout
}
